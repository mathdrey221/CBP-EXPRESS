# Supabase (projet personnel) — client (exposé au navigateur)
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=votre-project-id

# Supabase — serveur (SSR / server functions)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=votre-project-id

# Requis uniquement pour la création/invitation de membres par l'admin (page Équipe).
# À récupérer dans Supabase > Settings > API > service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=
